# Backend service environment variables.
# Server-side only. Do not expose database credentials to web or mobile apps.
ENVIRONMENT=development
SUPABASE_DB_HOST=db.<project-ref>.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=replace-with-a-strong-supabase-password
SUPABASE_SSLMODE=require
DATABASE_URL=postgresql+psycopg://postgres:replace-with-a-strong-supabase-password@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:replace-with-a-strong-supabase-password@db.<project-ref>.supabase.co:5432/postgres?ssl=require
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:replace-with-a-strong-supabase-password@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-with-32-plus-random-bytes
JWT_ISSUER=elevra
JWT_AUDIENCE=elevra-students
ENABLE_DOCS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=5
