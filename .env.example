NODE_ENV=development
APP_NAME=elevra
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=elevra
POSTGRES_USER=elevra
POSTGRES_PASSWORD=elevra_dev_password

# Supabase production database settings (server-side only; never expose these to clients)
SUPABASE_DB_HOST=db.<project-ref>.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=replace-with-a-strong-supabase-password
SUPABASE_SSLMODE=require

DATABASE_URL=postgresql+psycopg://postgres:replace-with-a-strong-supabase-password@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:replace-with-a-strong-supabase-password@db.<project-ref>.supabase.co:5432/postgres?ssl=require
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:replace-with-a-strong-supabase-password@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=5

REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

JWT_SECRET=replace-with-a-long-random-development-secret
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
